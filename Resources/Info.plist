<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The languages Settings offers. iOS only honours a per-app language the
	     bundle says it speaks, and pins Locale.current to the app's own
	     localization otherwise — so without these, dates and numbers would stay
	     English no matter what AppleLanguages held. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>vi</string>
		<string>ja</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<!-- Where you are is matched only against places this book has saved
	     spending at; it never leaves the phone. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mochi suggests the shop you are at from places you have saved spending before. Your location stays on this iPhone.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hoangtuan.mochi</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mochi</string>
			</array>
		</dict>
	</array>
	<!-- A book file has its own extension so the share sheet, AirDrop and
	     Files offer Mochi for it, and not for every other app's JSON. Opening
	     one copies it into the app (not in place) and shows what it would
	     change before anything is written. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.hoangtuan.mochi.book</string>
			<key>UTTypeDescription</key>
			<string>Mochi book</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mochi</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Mochi book</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.hoangtuan.mochi.book</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Mochi reads receipts on this iPhone to fill in a spend. Photos are never uploaded.</string>
</dict>
</plist>
