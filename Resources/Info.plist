<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The languages Settings offers. iOS only honours a per-app language the
	     bundle says it speaks, and pins Locale.current to the app's own
	     localization otherwise — so without these, dates and numbers would stay
	     English no matter what AppleLanguages held. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>vi</string>
		<string>ja</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<!-- Where you are is matched only against places this book has saved
	     spending at; it never leaves the phone. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mochi suggests the shop you are at from places you have saved spending before. Your location stays on this iPhone.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hoangtuan.mochi</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mochi</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Mochi reads receipts on this iPhone to fill in a spend. Photos are never uploaded.</string>
</dict>
</plist>
