<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The languages Settings offers. iOS only honours a per-app language the
	     bundle says it speaks, and pins Locale.current to the app's own
	     localization otherwise — so without these, dates and numbers would stay
	     English no matter what AppleLanguages held. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>vi</string>
		<string>ja</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<!-- Caprasimo draws the English headings; Baloo 2 draws them everywhere
	     else, because Caprasimo has no Vietnamese tone marks. Both are OFL,
	     and both licences ship beside them in the bundle. -->
	<key>UIAppFonts</key>
	<array>
		<string>Caprasimo-Regular.ttf</string>
		<string>Baloo2-ExtraBold.ttf</string>
	</array>
</dict>
</plist>
