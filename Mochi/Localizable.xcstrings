    "%lld say sold for a purchase already in your book. They add nothing — they mark the item you have as sold, and are on by default because the sheet knows the sale and the book does not." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件は帳簿にすでにある買い物について売却済みと書かれています。新しく追加はせず、手持ちの品物を売却済みにします。シートだけが売却を知っているため、既定で有効です。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dòng ghi đã bán cho món đã có trong sổ. Chúng không thêm gì — chỉ đánh dấu món bạn đang có là đã bán, và mặc định bật vì bảng biết vụ bán còn sổ thì chưa."
          }
        }
      }
    },
    "%lld smaller wallets" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
