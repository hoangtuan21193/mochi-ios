    "0%% over %lld months: %@ in all, last payment %@. No card debt is added." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "0%% over %1$lld months: %2$@ in all, last payment %3$@. No card debt is added."
