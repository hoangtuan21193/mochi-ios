        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có dòng tiêu đề nên các cột được lấy theo thứ tự trên. Thêm dòng tiêu đề thì thứ tự tuỳ ý — và bỏ bớt cột bạn không có."
          }
        }
      }
    },
    "No imports yet" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り込みはまだありません"
