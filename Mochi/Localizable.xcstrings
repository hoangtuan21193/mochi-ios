    },
    "With a date it enters the cash forecast on that day. Without one it counts in net worth only." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付があれば、その日に現金予測へ入ります。なければ純資産にだけ数えます。"
          }
