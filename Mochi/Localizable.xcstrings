      }
    },
    "Nothing due before then. Add cards, plans and monthly bills in Wallet so there is a schedule to draw." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それまでに支払いはありません。ウォレットにカード・分割払い・毎月の支払いを追加すると、支払い予定ができます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có gì đến hạn trước đó. Thêm thẻ, kế hoạch trả góp và hoá đơn hằng tháng trong Ví để có lịch trả."
          }
