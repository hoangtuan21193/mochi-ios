    "%lld items from this import go out of Inventory." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この取り込みの %lld 件が在庫から外れます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld món từ lần nhập này sẽ rời Kho hàng."
          }
        }
      }
    },
    "%lld items it marked sold, from rows for purchases already in the book." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳簿にすでにあった買い物の行により、%lld 件を売却済みにしました。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld món được đánh dấu đã bán, từ các dòng trùng với món đã có trong sổ."
          }
        }
      }
    },
    "%lld look like things you already have. They are off by default — two of the same lens is possible, so the choice stays yours." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件は既にあるものと似ています。既定ではオフです。同じレンズを 2 本持つこともあるので、判断はあなたに任せます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld món trông giống thứ bạn đã có. Mặc định chúng bị tắt — hai ống kính giống nhau là chuyện thường, nên quyết định là của bạn."
          }
        }
      }
    },
    "%lld match something you already have, or a row this sheet repeats. The sure ones are off by default — two of the same lens, bought twice, is a real thing, so the choice stays yours." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件が既にある品、またはこのシートが繰り返している行と一致します。確実なものは既定でオフです。同じレンズを二度買うことは実際にあるので、判断はあなたに任せます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dòng khớp với món bạn đã có, hoặc là dòng bị lặp trong sheet này. Những dòng chắc chắn được tắt sẵn — mua hai lần cùng một ống kính là chuyện thật, nên quyền chọn là của bạn."
          }
        }
      }
    },
    "%lld matched channels you already have; %lld are new and will be created. A new name that is really one of yours misspelt can be pointed at it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld matched channels you already have; %2$lld are new and will be created. A new name that is really one of yours misspelt can be pointed at it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件は既存のチャネルに一致し、%lld 件は新規に作成されます。実は既存名の綴り違いなら、既存のものに割り当てられます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld khớp với kênh bạn đã có; %lld là mới và sẽ được tạo. Một tên mới thực ra là tên cũ viết sai có thể trỏ về tên cũ."
          }
        }
      }
    },
