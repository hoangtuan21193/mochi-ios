        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Là nhãn trên món hàng, chưa phải danh mục. Biến một nhãn thành danh mục thật thì nó có danh sách thuộc tính; để yên thì không đổi gì."
