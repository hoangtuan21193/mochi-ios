    "· %@ on %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "· %1$@ on %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@（%@）"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ trên %@"
          }
        }
      }
    },
    "\"Everything else\" is read off the card statements: what they hold beyond the items in Inventory and the bills listed. Nothing to type." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「その他すべて」はカードの明細から読み取ります。在庫にあるアイテムと登録済みの支払い以外の分です。入力は不要です。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mọi thứ khác” được đọc từ sao kê thẻ: phần ngoài các món trong Kho hàng và các hoá đơn đã liệt kê. Không cần nhập gì."
          }
        }
      }
    },
    "\"Me\" cannot be removed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自分」は削除できません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xoá “Tôi”."
          }
        }
      }
    },
    "\"Me\" is built in — the card drawdown splits your bills from the ones you pay on behalf of others by it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自分」は組み込みです。カードの引き落としは、これを使って自分の支払いと立て替え分を分けます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tôi” có sẵn — phần rút thẻ dựa vào đó để tách hoá đơn của bạn khỏi hoá đơn bạn trả hộ người khác."
          }
        }
      }
    },
