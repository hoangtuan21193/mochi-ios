    "%lld" : {
      "shouldTranslate" : false
    },
    "%lld are the same purchase as something you already have, or a row this sheet repeats — same item, same purchase date, same market. They are off by default; a row that only shares a name or a date is a different purchase and comes in." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件はすでにある買い物と同じか、このシートが繰り返している行です（同じ品物・同じ購入日・同じ購入先）。既定では取り込みません。名前か日付だけが同じ行は別の買い物なので取り込みます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dòng trùng với món bạn đã có, hoặc là dòng lặp trong chính bảng này — cùng món, cùng ngày mua, cùng nơi mua. Mặc định bỏ qua; dòng chỉ trùng tên hoặc trùng ngày là món khác nên vẫn được nhập."
          }
        }
      }
    },
