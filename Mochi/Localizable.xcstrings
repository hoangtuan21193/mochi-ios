    "Items bought on it keep their history but lose the card link." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカードで買ったアイテムは履歴を保ちますが、カードとの結び付きはなくなります。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Món mua bằng thẻ vẫn giữ lịch sử nhưng mất liên kết thẻ."
          }
        }
      }
    },
    "Items marked Keeping are excluded from these numbers: %lld." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「保有」の付いたアイテムはこれらの数字に含みません：%lld 件。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Món đánh dấu Giữ lại không nằm trong các số này: %lld."
          }
        }
      }
    },
    "Items marked Keeping are excluded from these numbers: %lld. Stock planned for a point channel pays points, not yen, so its price is only in the points line." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「保有」の付いたアイテムはこれらの数字に含みません：%lld 件。ポイントチャネルで売る予定の在庫は円ではなくポイントで支払われるため、その金額はポイントの行にだけ入ります。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Món đánh dấu Giữ lại không nằm trong các số này: %lld. Hàng dự định bán qua kênh điểm trả bằng điểm chứ không phải yên, nên giá của nó chỉ nằm ở dòng điểm."
          }
        }
      }
    },
    "Its %@ leaves your cash total." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その %@ が現金合計から出ます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ của nó rời tổng tiền mặt."
          }
        }
      }
    },
    "Its instalment plan stays in Wallet — the lender is still owed either way." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割払いプランはウォレットに残ります。どちらにせよ信販会社への債務は消えません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kế hoạch trả góp vẫn ở Ví — dù sao vẫn còn nợ bên cho vay."
