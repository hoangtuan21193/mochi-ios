    "Is this for sale?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは販売用ですか？"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Món này để bán chứ?"
          }
        }
      }
    },
    "It leaves Safe to spend and the forecast. Pause it instead if it only stops for a while." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「使ってよい額」と予測から外れます。しばらく止めるだけなら、削除ではなく一時停止にしてください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó rời Có thể tiêu và bản dự báo. Nếu chỉ ngưng một thời gian thì hãy tạm dừng thay vì xoá."
          }
        }
      }
    },
    "It still carries %@ of debt, which will disappear from your totals." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ %@ の残債があります。合計から消えます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó vẫn mang %@ nợ, khoản này sẽ biến mất khỏi tổng của bạn."
          }
        }
      }
    },
    "It still owes %@, which will disappear from your totals." : {
      "localizations" : {
