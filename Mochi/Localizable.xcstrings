    },
    "What sold" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "売れたもの"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã bán những gì"
          }
        }
      }
    },
    "What the stock would fetch after fees if it all sold, and what this month's sales made after fees. Cost, margin and points are in Inventory and Stats." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在庫をすべて売った場合の手数料差引後の金額と、今月確定した売却の手数料差引後の利益。原価・見込み利益・ポイントは在庫と統計にあります。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số tiền thu về sau phí nếu bán hết hàng tồn, và lợi nhuận sau phí của các đơn đã bán trong tháng này. Giá vốn, lãi dự kiến và điểm nằm ở Kho hàng và Thống kê."
          }
        }
      }
    },
    "What this category asks about every item in it" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカテゴリーが各アイテムについて尋ねる項目"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh mục này hỏi gì về mỗi món trong nó"
          }
        }
      }
    },
    "What you paid. ¥ and commas are fine." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払った金額です。¥ やカンマが入っていても読めます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số bạn đã trả. ¥ và dấu phẩy đều được."
          }
        }
      }
    },
    "What you think it is worth now." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまいくらの価値だと思うかです。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn nghĩ giờ nó đáng bao nhiêu."
          }
        }
      }
    },
    "What your income and bills say the month should leave. From next month this is the real change instead — the app writes your position down once a month." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収入と支払いから見て、今月に残るはずの額です。来月からはここが実際の増減になります。アプリは月に 1 回、状況を記録します。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con số mà thu nhập và hoá đơn nói tháng này lẽ ra để lại. Từ tháng sau đây sẽ là mức thay đổi thật — ứng dụng ghi lại tình hình của bạn mỗi tháng một lần."
          }
        }
      }
    },
    "Where you plan to sell. A name this book does not have is created on import. Left blank, the item comes in as Keeping." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "売る予定の場所です。帳簿にない名前は取り込み時に作成されます。空欄なら「保有」として取り込まれます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nơi bạn định bán. Tên sổ chưa có sẽ được tạo khi nhập. Để trống thì món vào dưới dạng Giữ lại."
          }
        }
      }
    },
    "Who" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手"
