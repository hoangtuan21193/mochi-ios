        }
      }
    },
    "Everything you own less everything you owe, against where it stood on the 1st. Cash, stock, cards, plans and loans together." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持っているものすべてから、負っているものすべてを引いた額を、1 日時点と比べたものです。現金・在庫・カード・分割払い・貸し借りをまとめて見ます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ bạn có trừ mọi thứ bạn nợ, so với mức ngày mùng 1. Gồm tiền mặt, hàng tồn, thẻ, kế hoạch trả góp và vay mượn."
          }
        }
      }
