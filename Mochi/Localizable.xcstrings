    },
    "Nothing entered yet. Load a sample book to see how the screens read with real numbers in them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何も入力されていません。サンプル帳簿を読み込むと、実際の数字が入った画面を確認できます。"
          }
        },
        "vi" : {
          "stringUnit" : {
