    "%@ arrives on the %lldth; Safe to spend counts it when the day falls before the horizon." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ arrives on the %2$lldth; Safe to spend counts it when the day falls before the horizon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が %lld 日に入ります。その日が期間内なら「使ってよい額」に加算されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ về vào ngày %lld; Có thể tiêu tính khoản này khi ngày đó nằm trước mốc thời gian."
          }
